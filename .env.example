# ROD do Cerrado — exemplo de configuração
# Copie para .env e preencha localmente. Nunca versione o .env real.

# Telegram (obrigatório)
TELEGRAM_TOKEN=123456789:substitua-pelo-token-real
ALLOWED_USER_ID=123456789

# Ambiente
TIMEZONE=America/Sao_Paulo
INTENT_CONFIDENCE_THRESHOLD=0.88
SCHEDULER_INTERVAL_SECONDS=30
HYDRATION_MIN_INTERVAL_MINUTES=10

# Wake-on-LAN (opcional)
PC_MAC=
PC_IP=

# Fontes públicas leves (opcionais)
LOCAL_WEB_TOOLS_ENABLED=true
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_FETCH_MAX_CHARS=12000
WEB_USER_AGENT=ROD-do-Cerrado/1.0
RSS_FEEDS_ENABLED=true
RSS_FEEDS=
CURRENT_INFO_BRASILEIRAO_URL=

# Dashboard/API. Mantenha a porta 8000 restrita à LAN ou VPN.
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=marcelo
# Gere os dois segredos com: python scripts/generate_dashboard_credentials.py
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL_SECONDS=28800
# Ative somente atrás de HTTPS.
DASHBOARD_COOKIE_SECURE=false
